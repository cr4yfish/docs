{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Genie",
  "description": "Build real apps without a developer. Describe what you need and Genie generates it instantly.",
  "colors": {
    "primary": "#7C3AED",
    "light": "#EDE9FE",
    "dark": "#4C1D95"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "global": {
          "anchors": [
            {
              "anchor": "Home",
              "icon": "house",
              "href": "/"
            },
            {
              "anchor": "Community",
              "icon": "users",
              "href": "https://genie-app.de/community"
            },
            {
              "anchor": "Pricing",
              "icon": "credit-card",
              "href": "https://genie-app.de/pricing"
            }
          ]
        },
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Get Started",
                "icon": "rocket",
                "expanded": true,
                "pages": [
                  "introduction",
                  "quickstart",
                  "templates"
                ]
              },
              {
                "group": "Changelog",
                "icon": "rss",
                "pages": [
                  "changelog/overview"
                ]
              },
              {
                "group": "Projects",
                "icon": "folder",
                "pages": [
                  "projects/overview",
                  "projects/import-design",
                  "projects/settings",
                  "projects/secrets",
                  "projects/visibility"
                ]
              },
              {
                "group": "Workspaces",
                "icon": "building-2",
                "pages": [
                  "workspaces/overview",
                  "workspaces/members",
                  "workspaces/integrations",
                  "workspaces/pii-rules",
                  "workspaces/mcp-api"
                ]
              },
              {
                "group": "Genie Cloud",
                "icon": "cloud",
                "pages": [
                  "cloud/overview",
                  "cloud/database",
                  "cloud/storage",
                  "cloud/auth"
                ]
              },
              {
                "group": "Billing & Plans",
                "icon": "credit-card",
                "pages": [
                  "billing/plans",
                  "billing/credits",
                  "billing/topups"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "de",
        "global": {
          "anchors": [
            {
              "anchor": "Startseite",
              "icon": "house",
              "href": "/de"
            },
            {
              "anchor": "Community",
              "icon": "users",
              "href": "https://genie-app.de/community"
            },
            {
              "anchor": "Preise",
              "icon": "credit-card",
              "href": "https://genie-app.de/pricing"
            }
          ]
        },
        "tabs": [
          {
            "tab": "Dokumentation",
            "groups": [
              {
                "group": "Loslegen",
                "icon": "rocket",
                "expanded": true,
                "pages": [
                  "de/introduction",
                  "de/quickstart",
                  "de/templates"
                ]
              },
              {
                "group": "Changelog",
                "icon": "rss",
                "pages": [
                  "de/changelog/overview"
                ]
              },
              {
                "group": "Projekte",
                "icon": "folder",
                "pages": [
                  "de/projects/overview",
                  "de/projects/import-design",
                  "de/projects/settings",
                  "de/projects/secrets",
                  "de/projects/visibility"
                ]
              },
              {
                "group": "Workspaces",
                "icon": "building-2",
                "pages": [
                  "de/workspaces/overview",
                  "de/workspaces/members",
                  "de/workspaces/integrations"
                ]
              },
              {
                "group": "Genie Cloud",
                "icon": "cloud",
                "pages": [
                  "de/cloud/overview",
                  "de/cloud/database",
                  "de/cloud/storage",
                  "de/cloud/auth"
                ]
              },
              {
                "group": "Abrechnung & Tarife",
                "icon": "credit-card",
                "pages": [
                  "de/billing/plans",
                  "de/billing/credits",
                  "de/billing/topups"
                ]
              },
              {
                "group": "Datenschutz & Compliance",
                "icon": "shield",
                "pages": [
                  "de/compliance/kunden-compliance-paket",
                  "de/compliance/subprocessors",
                  "de/compliance/tom",
                  "de/compliance/ai-dpa"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
